# Supabase - same values from your current Streamlit secrets
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Teacher credentials as JSON (server-side only, never exposed to client)
TEACHER_CREDENTIALS={"aman":"yourpassword","trainer2":"pass456"}

# Used to sign HttpOnly student/teacher session cookies.
AUTH_SECRET=replace-with-a-long-random-secret
