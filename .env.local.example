NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key
QWEN_API_KEY=your-nvidia-api-key
AI_MODEL=qwen3-coder-480b-a35b-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
TEACHER_CREDENTIALS={"aman":"yourpassword","trainer2":"pass456"}
TEACHER_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_CREDENTIALS={"admin":"your-admin-password"}
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Required in production for POST /api/curriculum/ingest-gitbook
GITBOOK_PYTHON_INDEX_URL=https://pda-assignments.consoleflare.com/python-for-data-analytics/1.python/1.python-documents.md
INGEST_SECRET=replace-with-a-long-random-ingest-secret

# Required for Moat controlled Apify ingestion. Never expose this to the browser.
APIFY_TOKEN=your-apify-token

# Optional: locks down /api/evaluate and /api/generate-feedback when set (breaks student browser auto-eval unless you proxy server-side)
# EVALUATE_SECRET=
